{
  "id": "penguin_strait",
  "title": "企鹅海峡危机",
  "subtitle": "一场关于海峡、面子与外交措辞的政治讽刺",
  "playerRole": "狐狸共和国外交部长",
  "workspaceLabel": "外交部战情室",
  "opening": "凌晨四点，企鹅海上共和国扣押了两艘狐狸渔船。争议小岛上没有居民，只有一块被两国地图同时印成本国颜色的石头。总统要求你在开盘前解决问题，或至少为它选一个不会开战的名字。",
  "phases": [
    { "id": "spark", "label": "扣船事件" },
    { "id": "posture", "label": "立场成形" },
    { "id": "escalation", "label": "红线测试" },
    { "id": "settlement", "label": "危机收束" },
    { "id": "ending", "label": "海峡后来史" }
  ],
  "historyEvaluations": [
    {
      "requirements": [{ "field": "final_outcome", "operator": "==", "value": "mutual_victory" }],
      "text": "十年后的外交史写道：企鹅海峡危机以和平协议结束，双方各自取得了对方从未承认过的全部让步。危机官方名称为“{{official_terms:last}}”。"
    },
    {
      "requirements": [{ "field": "final_outcome", "operator": "==", "value": "frozen_committee" }],
      "text": "十年后，临时海域管理委员会仍在讨论第一次会议的永久临时议程。危机没有解决，因而成为两国最稳定的双边机制。"
    },
    {
      "requirements": [{ "field": "final_outcome", "operator": "==", "value": "domestic_defeat" }],
      "text": "外交档案认为你成功阻止了战争；国内报纸认为你失去了一场本来没有人打算发动的战争。两种记录至今都宣布自己获胜。"
    },
    {
      "requirements": [{ "field": "final_outcome", "operator": "==", "value": "never_war" }],
      "text": "两国在事故升级后签署《从未发生战争协议》。后来的地图用虚线标出小岛，并用实线删除了责任。"
    },
    { "text": "海峡危机最终被归档为一次成功的未定义事件。" }
  ],
